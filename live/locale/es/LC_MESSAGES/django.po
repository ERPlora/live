#: ninja.py
#, python-format
msgid "Ensure this value has at least %(min_length)d character."
msgid_plural "Ensure this value has at least %(min_length)d characters."
msgstr[0] "Debe tener al menos %(min_length)d carácter."
msgstr[1] "Debe tener al menos %(min_length)d caracteres."

#: ninja.py
#, python-format
msgid "Ensure this value has at most %(max_length)d character."
msgid_plural "Ensure this value has at most %(max_length)d characters."
msgstr[0] "Debe tener como máximo %(max_length)d carácter."
msgstr[1] "Debe tener como máximo %(max_length)d caracteres."

#: ninja.py
#, python-format
msgid "Ensure this value has at least %(min_length)d item."
msgid_plural "Ensure this value has at least %(min_length)d items."
msgstr[0] "Debe tener al menos %(min_length)d elemento."
msgstr[1] "Debe tener al menos %(min_length)d elementos."

#: ninja.py
#, python-format
msgid "Ensure this value has at most %(max_length)d item."
msgid_plural "Ensure this value has at most %(max_length)d items."
msgstr[0] "Debe tener como máximo %(max_length)d elemento."
msgstr[1] "Debe tener como máximo %(max_length)d elementos."

#: ninja.py
#, python-format
msgid "Ensure this value is greater than %(gt)s."
msgstr "Debe ser mayor que %(gt)s."

#: ninja.py
#, python-format
msgid "Ensure this value is greater than or equal to %(ge)s."
msgstr "Debe ser mayor o igual que %(ge)s."

#: ninja.py
#, python-format
msgid "Ensure this value is less than %(lt)s."
msgstr "Debe ser menor que %(lt)s."

#: ninja.py
#, python-format
msgid "Ensure this value is less than or equal to %(le)s."
msgstr "Debe ser menor o igual que %(le)s."

#: ninja.py
#, python-format
msgid "Ensure this value is a multiple of %(multiple_of)s."
msgstr "Debe ser múltiplo de %(multiple_of)s."

#: ninja.py
#, python-format
msgid "Ensure that there are no more than %(max_digits)d digit in total."
msgid_plural "Ensure that there are no more than %(max_digits)d digits in total."
msgstr[0] "No puede tener más de %(max_digits)d dígito en total."
msgstr[1] "No puede tener más de %(max_digits)d dígitos en total."

#: ninja.py
#, python-format
msgid "Ensure that there are no more than %(decimal_places)d decimal place."
msgid_plural ""
"Ensure that there are no more than %(decimal_places)d decimal places."
msgstr[0] "No puede tener más de %(decimal_places)d decimal."
msgstr[1] "No puede tener más de %(decimal_places)d decimales."

#: ninja.py
#, python-format
msgid ""
"Ensure that there are no more than %(whole_digits)d digit before the decimal "
"point."
msgid_plural ""
"Ensure that there are no more than %(whole_digits)d digits before the "
"decimal point."
msgstr[0] "No puede tener más de %(whole_digits)d dígito antes de la coma decimal."
msgstr[1] ""
"No puede tener más de %(whole_digits)d dígitos antes de la coma decimal."

#: ninja.py
msgid "Enter a valid JSON."
msgstr "Introduce un JSON válido."

