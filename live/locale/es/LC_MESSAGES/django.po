#: slugs.py
msgid "This name is reserved."
msgstr "Este nombre está reservado."

#: slugs.py
msgid ""
"Use only lowercase letters, digits and hyphens, without a hyphen at the "
"start or the end."
msgstr ""
"Usa solo minúsculas, números y guiones, sin guion al principio ni al final."

#: slugs.py
#, python-format
msgid "Use at least %(min)d characters."
msgstr "Usa al menos %(min)d caracteres."

#: slugs.py
#, python-format
msgid "Use at most %(max)d characters."
msgstr "Usa como máximo %(max)d caracteres."

#: slugs.py
msgid "The name cannot start with “xn--”."
msgstr "El nombre no puede empezar por «xn--»."

